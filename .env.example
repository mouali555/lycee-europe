# ═══════════════════════════════════════════════════════════════
# Lycée Europe — Variables d'environnement Firebase
# ═══════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et remplissez vos clés Firebase
# Trouvez ces valeurs sur : https://console.firebase.google.com
# Projet → Paramètres → Vos applications → SDK Firebase
# ═══════════════════════════════════════════════════════════════

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
